# Copy to .env and fill in. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# Database password (used by both Postgres and the backend)
POSTGRES_PASSWORD=
# Signs login tokens; at least 32 characters. Changing it logs everyone out.
JWT_SECRET=
# Password for demo@wearwise.app when running: docker compose exec backend npm run seed
SEED_PASSWORD=

# Public address of the site, no trailing slash (e.g. https://wearwise.example.com)
PUBLIC_URL=http://localhost:8080
# Where nginx listens on the host. Locally 127.0.0.1:8080; behind Caddy on the server keep 127.0.0.1
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# Proxies in front of the backend: 1 locally (nginx), 2 on the server (Caddy + nginx)
TRUST_PROXY=1
