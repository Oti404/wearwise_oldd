# Server
PORT=3000
NODE_ENV=development

# Database (self-hosted Postgres with pgvector)
DATABASE_URL=postgres://wearwise:change-me@localhost:5432/wearwise
# Set to "require" only when connecting to a remote database over the internet
DB_SSL=
DB_POOL_MAX=10

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Uploads — directory for user images (a Docker volume in production) and this API's public URL
UPLOAD_DIR=./uploads
PUBLIC_API_URL=http://localhost:3000

# AI Engine
AI_ENGINE_URL=http://localhost:7860

# Security
ALLOWED_ORIGINS=http://localhost:8081

# Demo seed (npm run seed) — password for demo@wearwise.app
SEED_PASSWORD=
