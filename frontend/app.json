{
  "expo": {
    "name": "WearWise",
    "slug": "WearWiseApp",
    "version": "1.0.0",
    "icon": "./assets/images/icon.png",
    "scheme": "wearwiseapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "platforms": ["web"],
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
